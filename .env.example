# ─────────────────────────────────────────────────────────────────────────────
# Cal🔥Caliente — environment variables
#
# Copy to `.env` (gitignored) and fill in. There are TWO groups:
#   1. SERVER vars  — read by the Node API (server/_core/env.ts). Stay on the server.
#   2. CLIENT vars  — `EXPO_PUBLIC_*`, INLINED INTO THE JS BUNDLE AT BUILD TIME.
#                     They are NOT secret and MUST be present when you build the
#                     app, or login breaks at runtime (getLoginUrl builds
#                     "undefined/app-auth"). In the Manus preview these are
#                     injected automatically; for any build OUTSIDE Manus you
#                     must set them yourself.
#
# Several values are the SAME logical thing under a server name and a client
# name (app id, OAuth server URL) — a Manus scaffolding quirk. Set both.
# ─────────────────────────────────────────────────────────────────────────────

# ── 1. SERVER (Node API) ─────────────────────────────────────────────────────

# REQUIRED — MySQL/TiDB connection string. Local dev points at Docker MySQL on
# :3307; in production use the connection string from Manus's database panel.
DATABASE_URL="mysql://user:password@host:3307/cal_caliente"

# REQUIRED — secret used to sign session JWTs / cookies. Any long random string.
#   openssl rand -hex 32
JWT_SECRET="change-me-to-a-long-random-string"

# REQUIRED for login — Manus OAuth token/userinfo server (token exchange,
# GetUserInfo). Copy from the Manus env panel.
OAUTH_SERVER_URL="https://oauth.manus.example/..."

# REQUIRED for login — Manus app id (server reads VITE_APP_ID; the client reads
# EXPO_PUBLIC_APP_ID below — set both to the same value).
VITE_APP_ID="your-manus-app-id"

# OPTIONAL — the openId that should be granted the `admin` role on first sign-in
# (upsertUser). Leave empty and there is no admin (adminProcedure is unreachable).
OWNER_OPEN_ID=""

# REQUIRED for LLM event extraction — Manus "forge" LLM endpoint + key. Without
# these the HTML scraper's extraction step is disabled.
BUILT_IN_FORGE_API_URL="https://forge.manus.im/..."
BUILT_IN_FORGE_API_KEY="your-forge-key"

# OPTIONAL — backend port (default 3000) and mode.
# PORT=3000
# NODE_ENV=development

# OPTIONAL but REQUIRED FOR PRODUCTION WEB — comma-separated extra CORS origins.
# The allowlist (server/_core/cors.ts) already permits localhost + *.manuspre.computer;
# add your real web domain here or browser-based auth is blocked.
#   ALLOWED_ORIGINS="https://app.example.com,https://www.example.com"
ALLOWED_ORIGINS=""

# OPTIONAL — only for the Facebook/Instagram scraper adapters (stubs without them).
# FACEBOOK_GRAPH_API_TOKEN=""
# INSTAGRAM_GRAPH_API_TOKEN=""

# ── 2. CLIENT (Expo — EXPO_PUBLIC_*, inlined at build, NOT secret) ────────────

# REQUIRED for login — Manus auth portal that renders the sign-in page. This is
# the single most-missed var: unset = the "Sign In" button goes nowhere.
EXPO_PUBLIC_OAUTH_PORTAL_URL="https://portal.manus.example"

# REQUIRED for login — same OAuth server URL as OAUTH_SERVER_URL above.
EXPO_PUBLIC_OAUTH_SERVER_URL="https://oauth.manus.example/..."

# REQUIRED for login — same app id as VITE_APP_ID above.
EXPO_PUBLIC_APP_ID="your-manus-app-id"

# OPTIONAL — owner identity surfaced in the client.
EXPO_PUBLIC_OWNER_OPEN_ID=""
EXPO_PUBLIC_OWNER_NAME=""

# OPTIONAL — pin the client at a specific backend URL. If unset, on web the
# client derives the API host from the current hostname (Manus's 8081-→3000-
# rewrite). REQUIRED for native builds and any standalone web deploy.
#   EXPO_PUBLIC_API_BASE_URL="https://api.example.com"
EXPO_PUBLIC_API_BASE_URL=""
