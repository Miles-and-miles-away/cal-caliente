# Copy to functions/.env (gitignored). firebase-functions v6 auto-loads it in
# both the emulator and deploys.
# Free key from https://aistudio.google.com/apikey (AI Studio — NOT Vertex).
GEMINI_API_KEY=

# Set to "true" to enforce App Check on the callables. Leave unset until every
# client ships App Check tokens and the apps are registered in the Firebase
# console, or callable requests will start failing.
ENFORCE_APP_CHECK=
